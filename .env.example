# Opcional: usa un Chromium del sistema en lugar del navegador de Playwright.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
DATABASE_URL=file:./prisma/dev.db
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna

# Publicación real de documentos PDF en LinkedIn.
# Requiere una app aprobada para Community Management y el permiso
# w_organization_social (página) o w_member_social (perfil).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:organization:123456789
LINKEDIN_API_VERSION=202605

# Protege /api/linkedin/dispatch. Un cron externo debe invocarlo periódicamente.
CRON_SECRET=cambia-este-valor-largo-y-aleatorio
KALLIOM_BASE_URL=http://localhost:3000
# LINKEDIN_POLL_INTERVAL_MS=60000
