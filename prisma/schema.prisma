generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model GenerationCache {
  key             String   @id
  normalizedInput String
  requestJson     String
  responseJson    String
  model           String
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  createdAt       DateTime @default(now())
  projects        Project[]
}

model Project {
  id               String          @id
  cacheKey         String
  topic            String
  title            String
  subtitle         String
  slideCount       Int
  category         String
  language         String
  tone             String
  status           String          @default("generated")
  linkedInCopy     String
  model            String
  estimatedTokens  Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  generationCache  GenerationCache @relation(fields: [cacheKey], references: [key])
  slides           Slide[]

  @@index([cacheKey])
}

model Slide {
  id         String  @id
  projectId  String
  order      Int
  type       String
  title      String
  subtitle   String?
  body       String?
  highlight  String?
  cta        String?
  visualTags String
  templateId String
  assetId    String?
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, order])
  @@index([projectId])
}
